# Copy this file to `.env` and fill in the values.

# PostgreSQL connection string (PostgreSQL >= 15).
DATABASE_URL="postgresql://user:password@localhost:5432/dario_store"

# better-auth: a long random string used to sign sessions (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (SMTP). Nothing is sent until SMTP_HOST and MAIL_FROM are set; before that,
# emails are only printed in the server console. Any provider works (Brevo, Mailgun, Gmail app password, ...).
SMTP_HOST=""
SMTP_PORT="587"
# "true" for port 465 (implicit TLS); leave "false" for 587 (STARTTLS).
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# The sender shown to customers, e.g. Dario Store <no-reply@your-domain.tn>
MAIL_FROM=""
# Optional: where customer replies go.
MAIL_REPLY_TO=""
# Optional: who gets the "new order" email (comma-separated). Empty = every admin account.
ADMIN_NOTIFY_EMAIL=""

# Chat encryption at rest (messages and payment/proof photos are stored encrypted). 32 random bytes in base64:
#   openssl rand -base64 32
# BACK THIS KEY UP and use the same one everywhere the database is used: if it is lost, the encrypted chats
# can never be read again. Without it, chats are stored in plain text.
CHAT_ENCRYPTION_KEY=""
